# 中心部署环境文件模板。
# 复制到仓库外（推荐 /etc/labbridge/production.env），按现场填写后：
#   docker compose --env-file /etc/labbridge/production.env \
#     -f deploy/production/compose.yaml up -d --wait
# 文件里有数据库密码，属主改为部署账户并保持 0600，别放进仓库或镜像。

# PostgreSQL 业务库密码。生成方式：openssl rand -hex 24
# 只在空数据卷首次 initdb 时生效；换密码要重建库或按运维文档处理。
LABBRIDGE_POSTGRES_PASSWORD=

# 镜像 tag，与部署产物对应：
#   在线现场构建时可用 scripts/ops/export-images.sh 打出的 tag；
#   离线现场必须是导入的镜像 tar 里记录的同一个 tag。
LABBRIDGE_IMAGE_TAG=

# 凭据目录与读取组，来自 deploy/production/generate-credentials.sh 的输出。
# AUTH_GROUP 填部署账户的主组 GID（id -g 查看），容器靠它读 0640 的凭据文件。
LABBRIDGE_AUTH_DIR=
LABBRIDGE_AUTH_GROUP=

# ---- 以下按需修改，有默认值 ----

# Web 入口监听地址：默认只绑本机回环；浏览器或 Agent 跨机器访问时
# 改成中心内网地址（例如 192.168.1.10），并确认该网络受信任。
# 当前只支持 HTTP，改绑地址等于把未加密的认证头暴露给该网段。
LABBRIDGE_WEB_BIND_ADDR=127.0.0.1
LABBRIDGE_WEB_PORT=8080

# PostgreSQL 镜像，一般用导出产物清单里记录的同一个标签。
LABBRIDGE_POSTGRES_IMAGE=postgres:16.15-bookworm
