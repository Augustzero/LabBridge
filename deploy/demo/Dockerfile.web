FROM node:22.23.2-bookworm-slim AS builder

WORKDIR /src/web-console

COPY web-console/package.json web-console/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY web-console/ ./

# 镜像构建同时守住类型、页面行为和生产产物三个前端门禁。
RUN npm run typecheck \
    && npm run test -- --run \
    && npm run build \
    && test -f dist/index.html

FROM nginx:1.26.3-alpine AS web-runtime

COPY deploy/demo/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /src/web-console/dist /usr/share/nginx/html

USER nginx
EXPOSE 8080
STOPSIGNAL SIGQUIT
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
